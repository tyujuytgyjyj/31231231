NODE_ENV=development
PORT=4000
PUBLIC_APP_NAME=Cosmos
DATA_DIR=./data
DATABASE_PATH=./data/cosmos.sqlite
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_MAX_AGE_MS=604800000
TRUST_PROXY=0

PHOTON_API_BASE_URL=http://127.0.0.1:9655/v1
PHOTON_API_KEY=
PHOTON_UPSTREAM_MODEL=deepseek-chat
PHOTON_REQUEST_TIMEOUT_MS=90000
PHOTON_MAX_CONCURRENT_REQUESTS=12
API_USER_REQUESTS_PER_MINUTE=120

EMAIL_VERIFICATION_REQUIRED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Cosmos <noreply@example.com>
EMAIL_CODE_TTL_MINUTES=10

BCRYPT_ROUNDS=12

GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=replace-with-your-model-api-key
GEMINI_MODEL=gemma-4-31b-it
